    {
      "parameters": {
        "jsCode": "const ai = $input.first().json;\nconst product = $('Process & Normalize Data').first().json;\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n\n    productUrl: product.productUrl,\n    platform: product.platform,\n    productName: product.productName,\n\n    currentPrice: product.currentPrice,\n    originalPrice: product.originalPrice,\n    discountPercent: product.discountPercent,\n\n    rating: product.rating,\n    reviewCount: product.reviewCount,\n\n    category: product.category,\n    availability: product.availability,\n    imageUrl: product.imageUrl,\n\n    buyScore: ai.buyScore || 0,\n    recommendation: ai.recommendation || \"WAIT\",\n\n    pros: ai.pros || [],\n    cons: ai.cons || [],\n    riskFactors: ai.riskFactors || [],\n\n    explanation: ai.explanation || \"No explanation provided.\",\n    priceAssessment: ai.priceAssessment || \"FAIR\",\n    bestTimeToBuy: ai.bestTimeToBuy || \"No specific advice.\",\n\n    prosFlat: Array.isArray(ai.pros)\n      ? ai.pros.join(\" | \")\n      : \"N/A\",\n\n    consFlat: Array.isArray(ai.cons)\n      ? ai.cons.join(\" | \")\n      : \"N/A\",\n\n    risksFlat: Array.isArray(ai.riskFactors)\n      ? ai.riskFactors.join(\" | \")\n      : \"N/A\"\n  }\n}];"
      },
