    {
      "parameters": {
        "jsCode": "// ─── Classify Error ──────────────────────────────────────────────────────────\nconst err = $input.first().json;\nconst raw = err.message || err.error || String(err) || 'Unknown error';\n\nlet code     = 'INTERNAL_ERROR';\nlet httpCode = 500;\nlet message  = raw;\n\nif(raw.startsWith('INVALID_INPUT'))      { code = 'INVALID_INPUT';        httpCode = 400; }\nelse if (raw.startsWith('INVALID_URL'))         { code = 'INVALID_URL';          httpCode = 400; }\nelse if (raw.startsWith('UNSUPPORTED_URL'))     { code = 'UNSUPPORTED_URL';      httpCode = 400; }\nelse if (raw.startsWith('PRODUCT_NOT_FOUND'))   { code = 'PRODUCT_NOT_FOUND';    httpCode = 404; }\nelse if (raw.startsWith('MISSING_FIELD'))       { code = 'MISSING_FIELD';        httpCode = 422; }\nelse if (raw.startsWith('SCRAPER_ERROR'))       { code = 'SCRAPER_ERROR';        httpCode = 502; }\nelse if (raw.startsWith('AI_PARSE_ERROR'))      { code = 'AI_PARSE_ERROR';       httpCode = 502; }\nelse if (/timeout/i.test(raw))                  { code = 'API_TIMEOUT';          httpCode = 504; message = 'API_TIMEOUT: The request timed out. Please try again.'; }\nelse if (/google sheets/i.test(raw))            { code = 'SHEETS_WRITE_FAILURE'; httpCode = 500; }\n\nreturn [{ json: { success: false, code, message, httpCode, timestamp: new Date().toISOString() } }];"
      },
