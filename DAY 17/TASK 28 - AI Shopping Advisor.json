{
  "name": "AI Shopping Advisor",
  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json;\n\nconst productUrl =\n  input.productUrl ||\n  input[\"Product URL\"] ||\n  \"\";\n\nif (!productUrl) {\n  throw new Error(\"Product URL is missing\");\n}\n\nconst trimmed = productUrl.trim();\n\nconst amazonPattern =\n  /(amzn\\.in|amazon\\.(in|com|co\\.uk|de|fr|it|es|ca|com\\.au|co\\.jp))/i;\n\nconst flipkartPattern =\n  /flipkart\\.com/i;\n\nconst isAmazon = amazonPattern.test(trimmed);\nconst isFlipkart = flipkartPattern.test(trimmed);\n\nif (!isAmazon && !isFlipkart) {\n  throw new Error(\n    \"UNSUPPORTED_URL: Only Amazon and Flipkart product URLs are supported.\"\n  );\n}\n\nreturn {\n  json: {\n    productUrl: trimmed,\n    platform: isAmazon ? \"amazon\" : \"flipkart\",\n    submittedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "e8aea2d4-09db-408c-88e3-53e45f278724",
      "name": "Validate URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -864,
        -96
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const html = $json.body?.data || $json.data || '';\n\nconst productUrl = $('Validate URL').first().json.productUrl;\nconst platform = $('Validate URL').first().json.platform;\n\n// Product Title\nconst titleMatch =\n  html.match(/<title>(.*?)<\\/title>/i);\n\nconst productName =\n  titleMatch\n    ? titleMatch[1]\n        .replace(': Amazon.in', '')\n        .replace('Amazon.in', '')\n        .trim()\n    : 'Unknown Product';\n\n// Price Extraction\nconst priceMatch =\n  html.match(/₹\\s*([0-9,]+)/i) ||\n  html.match(/a-price-whole[^>]*>([0-9,]+)/i) ||\n  html.match(/\"price\":\"([0-9,.]+)\"/i) ||\n  html.match(/\"displayPrice\":\"₹?([0-9,.]+)\"/i);\n\nconst currentPrice =\n  priceMatch\n    ? Number(priceMatch[1].replace(/,/g, ''))\n    : 0;\n\n// Rating Extraction\nconst ratingMatch =\n  html.match(/([0-9.]+)\\s+out of 5 stars/i) ||\n  html.match(/\"rating\":\"([0-9.]+)\"/i);\n\nconst rating =\n  ratingMatch\n    ? parseFloat(ratingMatch[1])\n    : 0;\n\n// Review Count Extraction\nconst reviewMatch =\n  html.match(/([0-9,]+)\\s+ratings/i) ||\n  html.match(/([0-9,]+)\\s+global ratings/i);\n\nconst reviewCount =\n  reviewMatch\n    ? Number(reviewMatch[1].replace(/,/g, ''))\n    : 0;\n\n// Availability\nconst availability =\n  html.includes('In stock')\n    ? 'In Stock'\n    : html.includes('Currently unavailable')\n    ? 'Out of Stock'\n    : 'Unknown';\n\n// Category\nconst categoryMatch =\n  html.match(/nav-a-content[^>]*>(.*?)</i);\n\nconst category =\n  categoryMatch\n    ? categoryMatch[1].trim()\n    : 'Unknown';\n\n// Image\nconst imageMatch =\n  html.match(/\"large\":\"(https:[^\"]+)\"/i);\n\nconst imageUrl =\n  imageMatch\n    ? imageMatch[1]\n    : '';\n\n// Discount\nlet originalPrice = currentPrice;\nlet discountPercent = 0;\n\nconst mrpMatch =\n  html.match(/M\\.R\\.P\\.\\s*₹\\s*([0-9,]+)/i);\n\nif (mrpMatch) {\n  originalPrice = Number(\n    mrpMatch[1].replace(/,/g, '')\n  );\n\n  if (\n    originalPrice > currentPrice &&\n    currentPrice > 0\n  ) {\n    discountPercent = Math.round(\n      ((originalPrice - currentPrice) /\n        originalPrice) *\n        100\n    );\n  }\n}\n\nreturn [{\n  json: {\n    productUrl,\n    platform,\n    productName,\n    currentPrice,\n    originalPrice,\n    discountPercent,\n    rating,\n    reviewCount,\n    category,\n    availability,\n    imageUrl,\n\n    // DEBUG\n    priceMatches: html.match(/₹\\s*[0-9,]+/g) || [],\n\n    scrapedAt: new Date().toISOString()\n  }\n}];"
      },
